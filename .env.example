# grillme-demo 環境変数サンプル。`cp .env.example .env` して使う。
# .env は .gitignore / .dockerignore 済み（イメージにも含まれない）。

# アプリの公開ポート（ホスト側）。コンテナ内は常に 3000。
APP_PORT=3000

# LLM(llama-server, OpenAI 互換 /v1) のベース URL。
# Colima では既定でコンテナ→ホストを host.docker.internal で解決する。
# LLM を別ホストで動かす場合はその URL に変更する。
LLAMA_BASE_URL=http://host.docker.internal:8080

# llama-server に渡すモデル名（/v1/models の id と一致していなくても可）。
LLAMA_MODEL=gemma

# トークン無音が続いた時のアイドルタイムアウト(ms)。リサーチは長時間化するため余裕を持たせる。
LLAMA_IDLE_TIMEOUT_MS=120000
